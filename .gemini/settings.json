        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "name": "agentigram-AfterTool",
            "command": "'/opt/homebrew/Cellar/node/26.9.0/bin/node' '/Users/vishnu/Documents/code/clankergram/apps/daemon/bin/agentigram.mjs' 'hook' 'AfterTool' '--root' '/Users/vishnu/Documents/code/clankergram'",
