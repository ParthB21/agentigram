{
  "hooksConfig": {
    "enabled": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "agentigram-SessionStart",
            "command": "'/opt/homebrew/Cellar/node/26.9.0/bin/node' '/Users/vishnu/Documents/code/clankergram/apps/daemon/bin/agentigram.mjs' 'hook' 'SessionStart' '--root' '/Users/vishnu/Documents/code/clankergram'",
            "timeout": 3000,
            "description": "Forward Gemini CLI activity to Agentigram"
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "agentigram-BeforeAgent",
            "command": "'/opt/homebrew/Cellar/node/26.9.0/bin/node' '/Users/vishnu/Documents/code/clankergram/apps/daemon/bin/agentigram.mjs' 'hook' 'BeforeAgent' '--root' '/Users/vishnu/Documents/code/clankergram'",
            "timeout": 3000,
            "description": "Forward Gemini CLI activity to Agentigram"
