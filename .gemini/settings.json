          {
            "type": "command",
            "name": "agentigram-BeforeTool",
            "command": "'/opt/homebrew/Cellar/node/26.9.0/bin/node' '/Users/vishnu/Documents/code/clankergram/apps/daemon/bin/agentigram.mjs' 'hook' 'BeforeTool' '--root' '/Users/vishnu/Documents/code/clankergram'",
            "timeout": 3000,
            "description": "Forward Gemini CLI activity to Agentigram"
