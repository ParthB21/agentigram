        "hooks": [
          {
            "type": "command",
            "name": "agentigram-SessionEnd",
            "command": "'/opt/homebrew/Cellar/node/26.9.0/bin/node' '/Users/vishnu/Documents/code/clankergram/apps/daemon/bin/agentigram.mjs' 'hook' 'SessionEnd' '--root' '/Users/vishnu/Documents/code/clankergram'",
            "timeout": 3000,
