      "command": "/opt/homebrew/Cellar/node/26.9.0/bin/node",
      "args": [
        "/Users/vishnu/Documents/code/clankergram/apps/daemon/bin/agentigram.mjs",
        "mcp",
        "--root",
        "/Users/vishnu/Documents/code/clankergram"
      ],
      "cwd": "/Users/vishnu/Documents/code/clankergram",
      "trust": true
