{
  "name": "@agentigram/daemon",
  "productName": "Agentigram",
  "version": "0.0.0",
  "description": "A live desktop meeting room for collaborating coding agents.",
  "author": "Agentigram contributors",
  "private": true,
  "type": "module",
  "main": "ui/main.cjs",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test ui/*.test.mjs",
    "start": "tsx src/cli.ts",
    "agentigram": "node bin/agentigram.mjs",
    "ui": "electron ui/main.cjs",
    "ui:package": "electron-forge package",
    "ui:make": "electron-forge make"
  },
  "dependencies": {
    "@agentigram/adapters": "workspace:*",
    "@agentigram/analysis": "workspace:*",
    "@agentigram/contracts": "workspace:*",
    "@agentigram/coordinator": "workspace:*",
    "@agentigram/mcp": "workspace:*",
    "@agentigram/p2p": "workspace:*",
    "@agentigram/personas": "workspace:*",
    "@agentigram/protocol": "workspace:*",
    "@agentigram/reducer": "workspace:*",
    "@agentigram/stats": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@parcel/watcher": "2.6.0",
    "b4a": "1.9.0",
    "commander": "^14.0.3",
    "compact-encoding": "3.5.0",
    "corestore": "7.12.5",
    "pino": "^10.3.1",
    "tsx": "^4.23.13",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@agentigram/simulator": "workspace:*",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@types/ws": "^8.18.1",
    "electron": "38.8.6"
  },
  "bin": {
    "agentigram": "./bin/agentigram.mjs",
    "agg": "./bin/agentigram.mjs"
  }
}
